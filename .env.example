# Banco de dados (PostgreSQL)
# Para integração com JB: use a mesma DATABASE_URL do projeto tradicao-do-bicho-privado
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?schema=public"

# SSO - chave compartilhada com JB e Cassino (mesmo valor: jogueonline-sso-2024)
SSO_SECRET=jogueonline-sso-2024

# App (opcional)
NEXT_PUBLIC_APP_URL="https://seu-dominio.com"

# Gateway PIX ativo: xgate | gatebox | cyber (também em Admin → Gateway PIX)
# PIX_GATEWAY=xgate

# XGate PIX (configurável também pelo Admin; aqui ou no Coolify)
# XGATE_EMAIL=
# XGATE_PASSWORD=

# Cyber Payment (https://api.escalecyber.com/v1 — header X-API-Key)
# CYBER_PAYMENT_API_KEY=
# CYBER_PAYMENT_BASE_URL=https://api.escalecyber.com/v1

# Webhook de pagamento (obrigatório em produção)
# O gateway deve enviar X-Webhook-Secret ou X-Webhook-Signature (HMAC-SHA256 do body)
# Cyber Payment: use o secret do webhook criado no painel → mesmo valor em WEBHOOK_SECRET
# WEBHOOK_SECRET=seu-secret-compartilhado-com-o-gateway
