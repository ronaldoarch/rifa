# Banco de dados (PostgreSQL)
# Para integração com JB: use a mesma DATABASE_URL do projeto tradicao-do-bicho-privado
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?schema=public"

# SSO - chave compartilhada com JB e Cassino (mesmo valor: jogueonline-sso-2024)
SSO_SECRET=jogueonline-sso-2024

# App (opcional)
NEXT_PUBLIC_APP_URL="https://seu-dominio.com"

# Docker/Coolify: mapeie armazenamento persistente no host para /app/public/uploads
# (senão cada redeploy apaga logos/banners e as URLs no banco passam a dar 404).

# Gateway PIX ativo: xgate | gatebox | cyber | sarrix (também em Admin → Gateway PIX)
# PIX_GATEWAY=xgate

# XGate PIX (configurável também pelo Admin; aqui ou no Coolify)
# XGATE_EMAIL=
# XGATE_PASSWORD=

# Cyber Payment (https://api.escalecyber.com/v1 — header X-API-Key)
# CYBER_PAYMENT_API_KEY=
# CYBER_PAYMENT_BASE_URL=https://api.escalecyber.com/v1

# SarrixPay Enterprise (https://apiv1.sarrixpay.com — OAuth client credentials + Bearer)
# SARRIXPAY_CLIENT_ID=
# SARRIXPAY_CLIENT_SECRET=
# SARRIXPAY_BASE_URL=https://apiv1.sarrixpay.com

# Webhook de pagamento (opcional — SarrixPay costuma não permitir secret no painel)
# Se definir WEBHOOK_SECRET: o POST deve enviar o mesmo via header, Bearer ou ?token= na URL
# Se WEBHOOK_SECRET existir mas o gateway não assinar: WEBHOOK_SARRIX_ALLOW_UNSIGNED=true
# WEBHOOK_SECRET=
# WEBHOOK_SARRIX_ALLOW_UNSIGNED=false
