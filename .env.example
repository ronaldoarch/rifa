# Banco de dados (PostgreSQL 17 no Coolify ou local)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?schema=public"

# App (opcional)
NEXT_PUBLIC_APP_URL="https://seu-dominio.com"

# XGate PIX (configurável também pelo Admin; aqui ou no Coolify)
# XGATE_EMAIL=
# XGATE_PASSWORD=

# Webhook de pagamento (obrigatório em produção)
# O gateway deve enviar X-Webhook-Secret ou X-Webhook-Signature (HMAC-SHA256 do body)
# WEBHOOK_SECRET=seu-secret-compartilhado-com-o-gateway
